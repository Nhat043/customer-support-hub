# GCS bucket names are globally unique. Adjust the suffix if this name is taken.
project_id             = "artful-memento-473909-k0"
region                 = "asia-southeast1"
environment            = "dev"
attachment_bucket_name = "customer-support-hub-artful-memento-473909-k0-attachments"

# Cloud Run starts only after images and Secret Manager versions are ready.
deploy_cloud_run    = false
cloud_run_image_tag = "v1"

