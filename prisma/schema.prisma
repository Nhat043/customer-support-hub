generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum UserRole {
  USER
  ADMIN
  OPERATOR
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum RefreshTokenStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum WorkflowItemStatus {
  NEW
  TRIAGE
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum WorkflowPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkflowEventType {
  CREATED
  UPDATED
  ASSIGNED
  STATUS_CHANGED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  AGENT_ACTION
}

enum CommentAuthorType {
  USER
  AGENT
  SYSTEM
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique
  name      String
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  workspaces     Workspace[]
  memberships    Membership[]
  invitations    Invitation[]
  sessions       Session[]
  workflowItems  WorkflowItem[]
  workflowEvents WorkflowEvent[]
  comments       Comment[]
  attachments    Attachment[]
  auditLogs      AuditLog[]
  agentRuns      AgentRun[]
  agentMessages  AgentMessage[]
  memoryChunks   AgentMemoryChunk[]

  @@index([status])
}

model Workspace {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  slug           String
  name           String
  status         WorkspaceStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowItems  WorkflowItem[]
  workflowEvents WorkflowEvent[]
  comments       Comment[]
  attachments    Attachment[]
  auditLogs      AuditLog[]
  agentRuns      AgentRun[]
  agentMessages  AgentMessage[]
  memoryChunks   AgentMemoryChunk[]
  sessions       Session[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           MembershipRole   @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  role           MembershipRole
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String           @db.Uuid
  acceptedById   String?          @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSentBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([expiresAt])
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  fullName     String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions            Session[]
  memberships         Membership[]
  acceptedInvitations Invitation[]       @relation("InvitationAcceptedBy")
  sentInvitations     Invitation[]       @relation("InvitationSentBy")
  createdItems        WorkflowItem[]     @relation("CreatedBy")
  ownedItems          WorkflowItem[]     @relation("OwnedBy")
  comments            Comment[]
  auditLogs           AuditLog[]
  agentRuns           AgentRun[]
  uploadedFiles       Attachment[]       @relation("UploadedBy")
  actorWorkflowEvents WorkflowEvent[]
  memoryChunks        AgentMemoryChunk[] @relation("MemoryOwner")
  passwordResetOtps   PasswordResetOtp[]

  @@index([role])
  @@index([status])
}

model PasswordResetOtp {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  otpHash        String
  resetTokenHash String?  @unique
  attempts       Int      @default(0)
  expiresAt      DateTime
  verifiedAt     DateTime?
  consumedAt     DateTime?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Session {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  organizationId    String?       @db.Uuid
  workspaceId       String?       @db.Uuid
  refreshTokenHash  String
  deviceFingerprint String?
  ipAddress         String?
  userAgent         String?
  status            SessionStatus @default(ACTIVE)
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agentRuns     AgentRun[]
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@index([expiresAt])
  @@index([absoluteExpiresAt])
}

model RefreshToken {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @db.Uuid
  tokenHash String             @unique
  status    RefreshTokenStatus @default(ACTIVE)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime           @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([expiresAt])
}

model WorkflowItem {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  workspaceId    String?            @db.Uuid
  externalId     String?            @unique
  type           String
  title          String
  description    String?
  status         WorkflowItemStatus @default(NEW)
  priority       WorkflowPriority   @default(MEDIUM)
  ownerId        String?            @db.Uuid
  createdById    String             @db.Uuid
  dueAt          DateTime?
  metadata       Json?
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner        User?           @relation("OwnedBy", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User            @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  events       WorkflowEvent[]
  comments     Comment[]
  attachments  Attachment[]
  agentRuns    AgentRun[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([status])
  @@index([priority])
  @@index([ownerId])
  @@index([createdById])
  @@index([createdAt])
  @@index([updatedAt])
}

model WorkflowEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  workspaceId    String?           @db.Uuid
  workflowItemId String            @db.Uuid
  eventType      WorkflowEventType
  actorUserId    String?           @db.Uuid
  payload        Json?
  idempotencyKey String?           @unique
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workflowItem WorkflowItem @relation(fields: [workflowItemId], references: [id], onDelete: Cascade)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([workflowItemId])
  @@index([eventType])
  @@index([createdAt])
}

model Comment {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  workspaceId    String?           @db.Uuid
  workflowItemId String            @db.Uuid
  authorUserId   String?           @db.Uuid
  authorType     CommentAuthorType
  body           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workflowItem WorkflowItem @relation(fields: [workflowItemId], references: [id], onDelete: Cascade)
  authorUser   User?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  attachments  Attachment[]

  @@index([organizationId])
  @@index([workspaceId])
  @@index([workflowItemId])
  @@index([authorUserId])
  @@index([createdAt])
}

model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String?  @db.Uuid
  workflowItemId String   @db.Uuid
  commentId      String?  @db.Uuid
  storageKey     String
  fileName       String
  mimeType       String
  sizeBytes      Int
  uploadedById   String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  workflowItem WorkflowItem @relation(fields: [workflowItemId], references: [id], onDelete: Cascade)
  comment      Comment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)
  uploadedBy   User         @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([workflowItemId])
  @@index([commentId])
  @@index([uploadedById])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  action         String
  entityType     String
  entityId       String
  beforeState    Json?
  afterState     Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUser    User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([entityType])
  @@index([entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

model AgentRun {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  workspaceId    String?        @db.Uuid
  userId         String         @db.Uuid
  workflowItemId String?        @db.Uuid
  sessionId      String?        @db.Uuid
  modelName      String
  status         AgentRunStatus @default(RUNNING)
  inputSummary   String?
  outputSummary  String?
  traceToken     String?
  idempotencyKey String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflowItem WorkflowItem?      @relation(fields: [workflowItemId], references: [id], onDelete: SetNull)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  messages     AgentMessage[]
  memoryChunks AgentMemoryChunk[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([userId])
  @@index([workflowItemId])
  @@index([status])
  @@index([startedAt])
}

model AgentMessage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String?  @db.Uuid
  agentRunId     String   @db.Uuid
  role           String
  content        Json?
  toolName       String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([agentRunId])
  @@index([role])
  @@index([createdAt])
}

model AgentMemoryChunk {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String?  @db.Uuid
  userId         String   @db.Uuid
  sourceType     String
  sourceId       String?
  chunkText      String
  embeddingRef   String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user         User         @relation("MemoryOwner", fields: [userId], references: [id], onDelete: Cascade)
  agentRunId   String?      @db.Uuid
  agentRun     AgentRun?    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([workspaceId])
  @@index([userId])
  @@index([sourceType])
  @@index([sourceId])
  @@index([createdAt])
}
