NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api
WEB_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:replace-me@DATABASE_HOST:5432/workflow_platform_local?schema=public
REDIS_URL=redis://localhost:6379
AI_PROVIDER=mock
AI_MODEL=mock-function-caller
# Cost-abuse protection. Redis applies these quotas across every API replica.
AGENT_RATE_LIMIT_USER_PER_MINUTE=10
AGENT_RATE_LIMIT_ORGANIZATION_PER_MINUTE=60
# Gemini Developer API with an API key. Keep GEMINI_API_KEY only in .env.
# Set GEMINI_USE_VERTEX_AI=true only when using Vertex AI with OAuth/ADC credentials.
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# GEMINI_USE_VERTEX_AI=false
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
VECTOR_STORE=in-memory
QDRANT_URL=http://localhost:6333
# Deterministic vectors are useful only for offline development/tests. Production-like
# semantic retrieval uses the Gemini embedding API and a separate Qdrant collection.
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
QDRANT_COLLECTION=agent_memory_semantic_v1
# Attachment files are stored outside PostgreSQL. Local is the default for Docker
# development; set gcs only after the Terraform attachment bucket has been applied.
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=/tmp/customer-support-hub-uploads
# GCS_PROJECT_ID=your-gcp-project-id
# GCS_ATTACHMENT_BUCKET=your-private-attachment-bucket
# Local Docker only: absolute path to the ADC file created by
# `gcloud auth application-default login`. This file is mounted read-only.
# GCP_ADC_CREDENTIALS_FILE=/home/your-user/.config/gcloud/application_default_credentials.json
JWT_ACCESS_SECRET=replace-me-access-secret
REFRESH_TOKEN_PEPPER=replace-me-refresh-token-pepper
PASSWORD_RESET_TOKEN_PEPPER=replace-me-password-reset-token-pepper
CSRF_SECRET=replace-me-csrf-secret
# Legacy fallback for existing environments. Prefer REFRESH_TOKEN_PEPPER.
JWT_REFRESH_SECRET=replace-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_ABSOLUTE_TTL=90d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Leave EMAIL_PROVIDER empty to keep email delivery disabled during local development.
# For Gmail SMTP, use a Google App Password, never your regular Gmail password.
EMAIL_PROVIDER=
EMAIL_FROM="Customer Support Hub <your-gmail@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=
