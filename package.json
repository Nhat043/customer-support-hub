{
  "name": "customer-support-hub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:create": "prisma migrate dev --create-only --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:seed": "pnpm --filter @customer-support-hub/api db:seed",
    "test": "pnpm --filter @customer-support-hub/api test",
    "test:integration": "pnpm --filter @customer-support-hub/api test:integration",
    "test:e2e:smoke": "RUN_E2E_SMOKE_TESTS=true node --test apps/web/tests/e2e/*.test.mjs",
    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/client": "6.19.3",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.3.3",
    "prisma": "^6.12.0",
    "turbo": "^2.5.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0"
  }
}
